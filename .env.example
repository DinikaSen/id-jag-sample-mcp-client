# ---- Identity provider (OpenID Connect) -------------------------------------
# Where the user signs in. The ID token from this sign-in is sent to the gateway.
IDP_ISSUER=https://idp.example.com/oauth2/token
IDP_CLIENT_ID=sample-mcp-client
# Leave empty for a public client (PKCE only). Set it for a confidential client.
IDP_CLIENT_SECRET=
# Must include openid. Add profile/email if the ID token should carry those claims.
IDP_SCOPES=openid

# ---- MCP server (gateway) ----------------------------------------------------
MCP_SERVER_URL=https://gateway.example.com:8443/mcp/atlassian
# Leave MCP_CLIENT_ID empty to register dynamically at the discovered
# authorization server. Set both for a pre-registered confidential client.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
# Used only when the server advertises no scopes in its protected resource metadata.
MCP_SCOPES=
# Header the ID token is sent on. Must match the policy's idTokenHeader parameter.
ID_TOKEN_HEADER=X-ID-Token

# ---- Chat --------------------------------------------------------------------
# Optional. Without it the app still connects and /call works, but chat is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Local -------------------------------------------------------------------
# Both redirect URLs are served on this port:
#   http://localhost:8765/idp/callback  and  http://localhost:8765/mcp/callback
CALLBACK_PORT=8765
LOG_HTTP=true
