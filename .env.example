# ---- MCP server (gateway) ----------------------------------------------------
MCP_SERVER_URL=https://gateway.example.com:8443/mcp/atlassian

# Leave MCP_CLIENT_ID empty to register dynamically at the discovered
# authorization server. Set it for a pre-registered client; add the secret only
# for a confidential client (PKCE is used either way).
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Optional. Authorization server metadata document to use instead of the one the
# MCP server's protected resource metadata points to (same role as
# authServerMetadataUrl in Claude Code's .mcp.json).
MCP_AUTH_SERVER_METADATA_URL=

# Scope precedence: the 401 challenge's scope, then the protected resource
# metadata's scopes_supported, then this value. openid must end up in the
# request or no ID token is issued.
MCP_SCOPES=openid

# Header the ID token is sent on. Must match the policy's idTokenHeader parameter.
ID_TOKEN_HEADER=X-ID-Token

# ---- Chat --------------------------------------------------------------------
# Chat is optional. Without either route the app still connects and /call works.
#
# Route 1 (preferred): the gateway's Anthropic proxy. The gateway holds the
# Anthropic key; the client authenticates to the gateway with an API key sent
# on X-API-Key.
LLM_PROXY_URL=https://gateway.example.com:8443/default/anthropic-proxy
LLM_PROXY_API_KEY=
#
# Route 2: call Anthropic directly. Used only when LLM_PROXY_URL is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Local -------------------------------------------------------------------
# The redirect URL is http://localhost:<CALLBACK_PORT>/callback
CALLBACK_PORT=8765
LOG_HTTP=true
